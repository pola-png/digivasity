{
  "entities": {
    "users": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "fullName": { "type": "string", "description": "User's full name" },
        "email": { "type": "string", "format": "email", "description": "User's email address" },
        "whatsapp": { "type": "string", "description": "User's WhatsApp number" },
        "credits": { "type": "integer", "description": "Number of search credits remaining" },
        "lastCreditRefresh": { "type": "string", "description": "Last date (YYYY-MM-DD) credits were refreshed" },
        "subscription": {
          "type": "object",
          "properties": {
            "type": { "type": "string", "enum": ["none", "3days", "7days"] },
            "expiresAt": { "type": "string", "format": "date-time" }
          },
          "description": "Active subscription details"
        },
        "createdAt": { "type": "string", "format": "date-time", "description": "Account creation timestamp" }
      },
      "required": ["uid", "email"]
    },
    "resumes": {
      "title": "Resume",
      "description": "Saved resume data",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner's UID" },
        "title": { "type": "string", "description": "Resume title/name" },
        "data": { "type": "object", "description": "The complete resume data object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "data"]
    },
    "news": {
      "title": "News Post",
      "description": "Dynamic news and system updates published by administrators",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Title of the news" },
        "excerpt": { "type": "string", "description": "Short excerpt/summary of the news" },
        "content": { "type": "string", "description": "Markdown content of the news" },
        "date": { "type": "string", "description": "Formatted date (e.g. May 27, 2026)" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Publish timestamp" },
        "createdBy": { "type": "string", "description": "UID of the admin who published it" },
        "imageUrl": { "type": "string", "description": "Optional uploaded image URL" },
        "links": {
          "type": "array",
          "description": "Array of reference links, each containing name and url"
        }
      },
      "required": ["title", "excerpt", "content", "date", "createdAt", "createdBy"]
    },
    "notifications": {
      "title": "Notification",
      "description": "System-wide notification for users",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Title of the notification" },
        "message": { "type": "string", "description": "Notification message text" },
        "link": { "type": "string", "description": "Optional navigation path/view or external URL" },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" }
      },
      "required": ["title", "message", "createdAt", "createdBy"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "users",
      "description": "User profiles"
    },
    "/resumes/{resumeId}": {
      "schema": "resumes",
      "description": "User saved resumes"
    },
    "/news/{newsId}": {
      "schema": "news",
      "description": "Dynamic news updates"
    },
    "/notifications/{notificationId}": {
      "schema": "notifications",
      "description": "System-wide notifications"
    }
  }
}
