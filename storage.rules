rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is an admin
    // CRITICAL NOTICE: Firebase Cloud Storage security rules ONLY support referencing the standard "(default)" Firestore database.
    // Specifying a custom/named database ID is NOT supported in Storage rules and will cause runtime permissions errors.
    // Because this app uses custom database ID "ai-studio-8cec7ead-e1b4-48cc-9ba7-7226b701a140", we cannot check roles in Firestore.
    // Instead, we use the secure Email Whitelist check (verified via request.auth.token.email_verified).
    function isAdmin() {
      return isAuthenticated() && 
        request.auth.token.email_verified == true && (
          request.auth.token.email in [
            "ubyytech2023@gmail.com",
            "olamilekanobetter@gmail.com",
            "ezekielxap@gmail.com",
            "info@digiskiskillsconsult.com",
            "ubong.udoka@digiskillsconsult.com",
            "ubongp.udoka@gmail.com"
          ]
        );
    }

    // Allow public read on news images, but strictly restrict writes to administrators
    match /news/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Allow users to upload and manage files in their personal directories
    match /users/{userId}/{allPaths=**} {
      allow read, write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // Default deny for all other paths
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
